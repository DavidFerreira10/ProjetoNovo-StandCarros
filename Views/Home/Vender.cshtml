@using System.Runtime.InteropServices
@model ProjetoNovo.Models.dados.dadosViewModel
@{
    ViewData["Title"] = "Vender";
}

<div class="container mt-5">
    <h1>Vender Carros</h1>
    <p>Escolha o(s) veículo(s) que deseja vender!</p>
</div>

<form method="get">
<input type="text" name="marca" placeholder="Pesquisar por marca..." class="form-control" />
<button type="submit">Filtrar</button>
</form>


<div class="container mt-5">
    
    <div class="row mt-4">

        <h5 class="card-title">Carros Usados</h5>

        @foreach (var carro in Model.carroUsado)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@carro._nome</h5>

                        <p class="card-text">
                            Preço: @carro._preco.ToString("N2") €
                        </p>

                        <p class="card-text">
                            Ano: @carro._ano
                        </p>

                        <a href="#" class="btn btn-success btn-venda">
                            Vender
                        </a>
                    </div>
                </div>
            </div>
        }

        <h5 class="card-title">Carros Novos</h5>

        @foreach (var carro in Model.Carros)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@carro._nome</h5>

                        <p class="card-text">
                            Preço: @carro._preco.ToString("N2") €
                        </p>

                        <a href="#" class="btn btn-success btn-venda">
                            Vender
                        </a>
                    </div>
                </div>
            </div>
        }

        <h5 class="card-title">Informações do vendedor</h5>
        <h5 class="card-title">@Model.Cliente._nome</h5>
        <h5 class="card-title">@Model.Cliente._email</h5>

    </div>
</div>