@{
    ViewData["Title"] = "Home Page";
}



<div class="text-center">

    <figure class="text-center">
    <div class="text-center mt-5">
    <h1 class="display-3 fw-bold text-dark">
        AUTOStand
    </h1>

    <p class="lead text-secondary text-dark">
        O seu próximo automóvel está aqui.
    </p>

    <hr class="w-50 mx-auto">
</div>
    


    <div id="carouselExampleIndicators" class="carousel slide">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
            <img class="Carro" src="~/images/car1.png" alt="Fotografia de um carro"> <!-- Colocar a imagem na pasta images do wwwroot-->
            </div>
            <div class="carousel-item">
            <img class="Carro" src="~/images/SUV.png" alt="Fotografia de um carro"> <!-- Colocar a imagem na pasta images do wwwroot-->
            </div>
            <div class="carousel-item">
            <img class="Carro" src="~/images/Desportivo.png" alt="Fotografia de um carro"> <!-- Colocar a imagem na pasta images do wwwroot-->
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <div class="d-flex justify-content-center align-items-center gap-4 mt-5 botoes">
        <a asp-controller="Home" asp-action="Comprar" class="btn btn-primary"> Comprar Carros </a>

        <a asp-controller="Home" asp-action="Vender" class="btn btn-secondary">Vender Carro</a>

        <a asp-controller="Home" asp-action="Vebder" class="btn btn-info">Alugar Carro</a>
    </div>
    
    <!--<p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>-->

    
</div>
